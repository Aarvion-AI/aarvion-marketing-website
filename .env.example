# Environment variables for the Aarvion marketing site.
# Copy to .env.local for local development.
# For hosted environments, set these in the deployment project's environment variables.

# Use "ses" on AWS hosting. Leave blank to use Resend instead.
EMAIL_PROVIDER=ses

# AWS SES is configured in us-east-1 for aarvion.ai. On Amplify, grant the SSR
# compute role ses:SendEmail; do not add long-lived AWS credentials here.
SES_REGION=us-east-1

# Optional Resend fallback for non-AWS environments. Without SES or this key,
# /api/contact returns 503 and directs the visitor to email sales.
RESEND_API_KEY=

# Recipient for design-partnership applications. Defaults to sales@aarvion.ai.
CONTACT_TO=sales@aarvion.ai

# Sender identity. aarvion.ai is verified in AWS SES us-east-1.
CONTACT_FROM=Aarvion <noreply@aarvion.ai>
