# Environment variables for the Aarvion marketing site.
# Copy to .env.local for local development.
# For hosted environments, set these in the deployment project's environment variables.

# Resend API key — powers the design-partnership application email.
# Without it, the /api/contact route returns 503 and directs the visitor to email sales.
RESEND_API_KEY=

# Recipient for design-partnership applications. Defaults to sales@aarvion.ai.
CONTACT_TO=sales@aarvion.ai

# Sender identity. Defaults to "Aarvion <onboarding@resend.dev>" (Resend's
# shared sender). Swap to a verified aarvion.ai sender (e.g. noreply@aarvion.ai)
# once the aarvion.ai domain is verified in Resend.
CONTACT_FROM=Aarvion <onboarding@resend.dev>
